  <tool name="monofx_restart_houdini" label="Restart Houdini" icon="restart">
    <helpText><![CDATA[Save (optional) and restart Houdini, reopening the current .hip file.]]></helpText>
    <script scriptType="python"><![CDATA[
import hou
import os
import subprocess
import sys

def _houdini_executable():
    path_fn = getattr(hou, "applicationBinaryPath", None)
    if callable(path_fn):
        return path_fn()

    hfs = hou.getenv("HFS") or os.environ.get("HFS", "")
    if not hfs:
        raise hou.Error("Cannot locate Houdini install (HFS is not set).")

    bin_dir = os.path.join(hfs, "bin")
    candidates = []
    app = hou.applicationName()
    if app:
        candidates.append(app)
    candidates.extend(("houdini", "houdinifx", "houdinicore"))

    seen = set()
    for name in candidates:
        if name in seen:
            continue
        seen.add(name)
        exe_name = name if name.lower().endswith(".exe") else name + (".exe" if sys.platform == "win32" else "")
        path = os.path.join(bin_dir, exe_name)
        if os.path.isfile(path):
            return os.path.normpath(path)

    raise hou.Error("Cannot locate Houdini executable in %s." % bin_dir)

def _restart():
    exe = _houdini_executable()
    hip = hou.hipFile.path()
    args = [exe] + ([hip] if hip else [])
    flags = 0
    if sys.platform == "win32":
        flags = subprocess.DETACHED_PROCESS | subprocess.CREATE_NEW_PROCESS_GROUP
    subprocess.Popen(args, cwd=os.path.dirname(exe), creationflags=flags)
    hou.exit(suppress_save_prompt=True)

if hou.hipFile.hasUnsavedChanges():
    choice = hou.ui.displayMessage(
        "Restart Houdini?\n\nThe current scene has unsaved changes.",
        buttons=("Save & Restart", "Restart Without Saving", "Cancel"),
        default_choice=0,
        close_choice=2,
        severity=hou.severityType.Warning,
    )
    if choice == 0 and hou.hipFile.save():
        _restart()
    elif choice == 1:
        _restart()
else:
    choice = hou.ui.displayMessage(
        "Restart Houdini?",
        buttons=("Restart", "Cancel"),
        default_choice=0,
        close_choice=1,
    )
    if choice == 0:
        _restart()
]]></script>
  </tool>

  <tool name="monofx_scene_info" label="Scene Info" icon="info">
    <helpText><![CDATA[Show current .hip path and selected node count.]]></helpText>
    <script scriptType="python"><![CDATA[
import os, sys

def _is_suite_root(p):
    return bool(p) and os.path.isdir(p) and os.path.isdir(os.path.join(p, "tools"))

def _find_suite_root():
    import glob
    p = os.environ.get("MONOFX_SUITE")
    if _is_suite_root(p):
        return p

    # Installer: packages/monofx.json next to monofx/ (Documents/houdiniXX.X/...)
    pkg_dir_raw = os.environ.get("HOUDINI_PACKAGE_DIR") or ""
    for pkg_dir in [x.strip() for x in pkg_dir_raw.split(";") if x.strip()]:
        if os.path.isfile(os.path.join(pkg_dir, "monofx.json")) or os.path.isfile(os.path.join(pkg_dir, "monofx_standalone.json")):
            parent = os.path.normpath(os.path.join(pkg_dir, ".."))
            for root in (parent, os.path.join(parent, "monofx")):
                if _is_suite_root(root):
                    return root

    user_docs = os.path.expanduser("~/Documents")
    for monofx in sorted(glob.glob(os.path.join(user_docs, "houdini*", "monofx")), reverse=True):
        if _is_suite_root(monofx):
            return monofx

    for candidate in [os.path.expandvars(r"%ProgramFiles%\MonoFXSuite"), os.path.expandvars(r"%ProgramFiles(x86)%\MonoFXSuite")]:
        if _is_suite_root(candidate):
            return candidate

    return None

_mono_suite = _find_suite_root()
if _mono_suite and _mono_suite not in sys.path:
    sys.path.insert(0, _mono_suite)

if not _mono_suite:
    import hou
    hou.ui.displayMessage(
        "MonoFX: cannot locate suite root.\n\n"
        "1. Set HOUDINI_PACKAGE_DIR to your MonoFXSuite packages folder (e.g. C:\\Program Files\\MonoFXSuite\\packages)\n"
        "2. Remove any monofx.json from Documents\\houdini21.0\\packages (wrong MONOFX_SUITE)\n"
        "3. Restart Houdini.\n\n"
        "MONOFX_SUITE=%s\nHOUDINI_PACKAGE_DIR=%s" % (os.environ.get("MONOFX_SUITE"), os.environ.get("HOUDINI_PACKAGE_DIR")),
        severity=hou.severityType.Error,
    )
else:
    try:
        from tools.fx.scene_info import run
        run()
    except Exception as e:
        import hou
        hou.ui.displayMessage(str(e), severity=hou.severityType.Error)
]]></script>
  </tool>

