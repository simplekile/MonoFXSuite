fullscreen   -1
playbarshown 1
playbar      -1
shelf        -1
menubar      -1
statusbar    -1
radial menu set main
root {
    split 0.24 H {
        tabs 0 1 {
            pane panetab20 -a 0 -l 10 -H /stage/ -T LOP -m pythonpanel
        }
        split 0.609375 H {
            split 0.38293 V {
                tabs 0 1 {
                    pane pane1 -a 0 -B 1 -l 10 -H /stage/ -T LOP -m sceneview
                    pane panetab7 -a 0 -l 10 -H /stage/ -T LOP -m pythonpanel
                    pane panetab10 -a 0 -l 10 -H /stage/ -T LOP -m rendergallery
                }
                tabs 0 1 {
                    pane panetab8 -a 0 -l 10 -H /stage/ -T LOP -m details
                    pane panetab9 -a 0 -l 0 -H /stage/ -T LOP -m chaneditor
                    pane panetab3 -a 1 -l 10 -H /stage/ -T LOP -m pythonpanel
                    pane panetab12 -a 0 -l 10 -H /stage/ -T LOP -m pythonpanel
                    pane panetab11 -a 0 -l 10 -H /stage/ -T LOP -m pythonpanel
                }
            }
            split 0.520777 V {
                tabs 0 1 {
                    pane panetab1 -a 0 -l 10 -H /stage/ -T LOP -m parmeditor
                    pane panetab4 -a 0 -l 0 -H /stage/ -T LOP -m perfmon
                }
                tabs 0 1 {
                    pane panetab2 -a 0 -l 10 -H /stage/ -T LOP -m neteditor
                }
            }
        }
    }
}
shelfdock -o 1 -l icon_and_text -G "0.35 0.50 0.15" add solaris_1 solaris_2 solaris_3
geospreadsheet -c 0 -l horizontal -s 0.5 -m none -f 0 panetab10
scenegraphtree -S 0.25 -m 0 -c  -i  -o  -x 1 -s 1 -M 0 -C primtype,childcount,kind,populated,loaded,activation,visibility,solo,selectability  panetab10
parmeditor -T 0.25 -w 0 panetab1
pythonpanel -s on -t off -n contexteditor panetab3
performance -c on -d on -f on -g off -k on -m off -n on -o on -t off -v on -p on -y on -u on -e off -r absolute -R seconds -w tree panetab4
networkeditor -p '{\n	"showchilddep":"1",\n	"showdep":"0",\n	"showtaskgraphperf":"0",\n	"taskgraphperfstatname":"Cook Time",\n	"perfstatname":"Time",\n	"showperfstats":"1",\n	"grouplistsplit":"0.75",\n	"showtree":"0",\n	"showtypesidebar":"0",\n	"taskgraphsortcriteria":"Automatic",\n	"showparmdialogmax":"1",\n	"treesplit":"0.25",\n	"palettesize":"150 150",\n	"typesidebarsplit":"0.25",\n	"taskgraphcollapsemode":"Off",\n	"gridmode":"0",\n	"overviewbounds":"0.000000 0.000000 215.700000 113.400000",\n	"overviewmode":"2",\n	"showgrouplist":"0",\n	"palettemode":"0",\n	"showtasksmenu":"1",\n	"backgroundimageediting":"0",\n	"backgroundimagebrightness":"1.0",\n	"gridystep":"1.0",\n	"palettecolors":"",\n	"showmenu":"1",\n	"gridxstep":"2.0",\n	"showparmdialog":"0"\n}\n' panetab2
pythonpanel -s on -t off -n SceneGraphLayersPanel panetab7
pythonpanel -s on -t off -n log_viewer panetab11
pythonpanel -s on -t off -n clone_control panetab12
geospreadsheet -c 0 -l horizontal -s 0.5 -m none -f 0 panetab8
scenegraphtree -S 0.25 -m 2 -c  -i  -o  -x 1 -s 1 -M 0 -C primtype,childcount,kind,populated,loaded,activation,visibility,solo,selectability  panetab8
pythonpanel -s on -t off -n monofx_loader panetab20
