fullscreen   -1
playbarshown 1
playbar      -1
shelf        -1
menubar      -1
statusbar    -1
root {
    split 0.30 H {
        tabs 0 1 {
            pane panetab2 -a 0 -l 10 -H /obj/ -T OBJ -m pythonpanel
        }
        split 0.72 H {
            tabs 0 1 {
                pane panetab1 -a 0 -l 10 -H /obj/ -T OBJ -m sceneview
            }
            split 0.45 V {
                tabs 0 1 {
                    pane panetab3 -a 0 -l 10 -H /obj/ -T OBJ -m parmeditor
                }
                tabs 0 1 {
                    pane panetab4 -a 0 -l 10 -H /obj/ -T OBJ -m neteditor
                }
            }
        }
    }
}
shelfdock -o 1 -l icon_and_text -G "0.50 0.50" add shelf_set_1 shelf_set_2
viewerstow -x open -b open -l open -m hide -c hide -d open MONO_Grooming.panetab1.world
vieweroption -a 2 MONO_Grooming.panetab1.world
viewlayout -s 2 MONO_Grooming.panetab1.world
viewtype -t perspective MONO_Grooming.panetab1.world.`vpname("MONO_Grooming.panetab1.world",2)`
parmeditor -T 0.25 -w 0 panetab3
pythonpanel -s on -t off -n mono_grooming panetab2
